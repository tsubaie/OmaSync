# Maintainer: Talal A. Alsubaie <t.subaie@gmail.com>
# AUR package installing the prebuilt release. The release workflow fills pkgver and
# sha256sums, attaches the result to each GitHub release and pushes it to the AUR.
pkgname=omarchy-sync-bin
_pkgname=omarchy-sync
pkgver=@VERSION@
pkgrel=1
pkgdesc="Keep Omarchy settings, themes, plugins and apps the same on all your computers"
arch=('x86_64')
url="https://github.com/tsubaie/OmaSync"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'chezmoi' 'github-cli' 'git')
provides=('omarchy-sync')
conflicts=('omarchy-sync')
source=("$url/releases/download/v$pkgver/omarchy-sync-$pkgver-x86_64-linux.tar.gz")
sha256sums=('@SHA256@')
# The binary is already stripped; nothing to split into a debug package.
options=('!debug')

package() {
  cd "$srcdir/omarchy-sync-$pkgver"
  install -Dm755 omarchy-sync "$pkgdir/usr/bin/omarchy-sync"
  install -Dm644 omarchy-sync.desktop "$pkgdir/usr/share/applications/omarchy-sync.desktop"
  for size in 16 32 48 64 128 256 512; do
    install -Dm644 "icons/${size}x${size}/omarchy-sync.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/omarchy-sync.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$_pkgname/LICENSE"
}
