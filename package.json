{
  "name": "omarchy-sync",
  "private": true,
  "version": "0.1.4",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "lint": "oxlint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml -- --include-ignored",
    "audit:static": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm knip && pnpm depcruise",
    "audit:rust": "pnpm rust:fmt && pnpm rust:clippy && pnpm rust:test",
    "audit:all": "pnpm audit:static && pnpm test && pnpm audit:rust && pnpm test:e2e",
    "test:multi": "bash e2e/multi/run.sh"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.20",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "knip": "6.42.1",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webdriverio": "10.1.0"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  }
}
